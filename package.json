{
  "name": "psykl-system",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "PSYKL-System - time-independent planning tool around energy cycles. See docs/PRODUCT.md.",
  "license": "MIT",
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "format:check": "pnpm -r format:check",
    "typecheck": "pnpm -r typecheck",
    "test:unit": "pnpm -r test:unit",
    "test:integration": "pnpm -r test:integration",
    "test:component": "pnpm -r test:component",
    "test:e2e": "pnpm --filter @psykl/e2e test",
    "dev": "echo 'dev orchestrator wired up after components scaffold; for now run per-component: pnpm --filter <name> dev'",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --max-warnings 0 --fix",
      "prettier --write"
    ],
    "*.{js,jsx,json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.4.0",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "prettier": "^3.8.3",
    "typescript-eslint": "^8.59.4"
  }
}
