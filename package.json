{
  "name": "psykl-system",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "PSYKL-System - time-independent planning tool around energy cycles. See docs/PRODUCT.md.",
  "license": "MIT",
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "format:check": "pnpm -r format:check",
    "typecheck": "pnpm -r typecheck",
    "test:unit": "pnpm -r test:unit",
    "test:integration": "pnpm -r test:integration",
    "test:component": "pnpm -r test:component",
    "test:e2e": "pnpm --filter @psykl/e2e test",
    "test:e2e:ui": "pnpm --filter @psykl/e2e test:ui",
    "verify:prepare": "pnpm --filter @psykl/shared-types build && pnpm --filter @psykl/service-task build:openapi && pnpm --filter @psykl/web-client codegen",
    "verify:static": "pnpm lint && pnpm format:check && pnpm typecheck",
    "verify:unit": "pnpm test:unit",
    "verify:integration": "pnpm test:integration",
    "verify:component:install-browsers": "pnpm --filter @psykl/web-client exec playwright install --with-deps chromium",
    "verify:component": "pnpm test:component",
    "verify:e2e:install-browsers": "pnpm --filter @psykl/e2e exec playwright install --with-deps chromium",
    "verify:e2e": "pnpm test:e2e",
    "verify:e2e:up": "./scripts/e2e-up.sh",
    "verify:e2e:down": "./scripts/e2e-down.sh",
    "verify:e2e:logs": "./scripts/e2e-logs.sh",
    "verify:e2e:wait": "./scripts/wait-for-service-task.sh && ./scripts/wait-for-web-client.sh",
    "dev": "echo 'dev orchestrator wired up after components scaffold; for now run per-component: pnpm --filter <name> dev'",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --max-warnings 0 --fix",
      "prettier --write"
    ],
    "*.{js,jsx,json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.4.0",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "prettier": "^3.8.3",
    "typescript-eslint": "^8.59.4"
  }
}
